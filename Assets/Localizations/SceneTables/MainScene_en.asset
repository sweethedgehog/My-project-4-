      m_Items: []
  - m_Id: 100000000005
    m_Localized: 'Suit: Skulls Cards at the edges of the spread double their value'
    m_Metadata:
      m_Items: []
  - m_Id: 100000000006
    m_Localized: 'Suit: Coins A card doubles its value if it is next to another coin
