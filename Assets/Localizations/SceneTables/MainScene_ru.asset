  - m_Id: 100000000021
    m_Localized: Only value
    m_Metadata:
      m_Items: []
  - m_Id: 100000000022
    m_Localized: Nothing Here
    m_Metadata:
      m_Items: []
  - m_Id: 100000000023
    m_Localized: "\u041C\u0430\u0434\u0430\u043C \u041A\u0432\u0430\u043A\u0438\u043D\u0433!\n\u041D\u0435
      \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u043A\u0430\u043A \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u0435\u043D
      \u044F \u0432\u0430\u043C\n\u0437\u0430 \u043F\u0440\u0438\u0451\u043C. \u041A\u0430\u043A
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0430\u0443\u043A\u0438 \u044F
      \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043D\u0430\u0434\u0435\u044F\u043B\u0441\u044F,
      \u0447\u0442\u043E \u043E\u0431\u043E\u0439\u0434\u0443\u0441\u044C \u0431\u0435\u0437\u2026
      \u044D\u0437\u043E\u0442\u0435\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0438\u0437\u043B\u0438\u0448\u0435\u0441\u0442\u0432, \u043D\u043E \u043F\u043E\u043B\u0438\u0446\u0438\u044F
      \u0431\u0435\u0441\u0441\u0438\u043B\u044C\u043D\u0430.\n\u041F\u0440\u043E\u0448\u0443
      \u0432\u0430\u0441, \u043C\u0430\u0434\u0430\u043C, \u0437\u0430\u0433\u043B\u044F\u043D\u0438\u0442\u0435
      \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u0435\n\u0438 \u0441\u043A\u0430\u0436\u0438\u0442\u0435,
      \u043A\u0442\u043E \u0443\u0431\u0438\u043B\n\u043C\u043E\u044E \u0436\u0435\u043D\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000024
    m_Localized: "\u0411\u044B\u043B \u043F\u0430\u0441\u043C\u0443\u0440\u043D\u044B\u0439
      \u0432\u0435\u0447\u0435\u0440. \n\u041C\u044B \u0441 \u041B\u0438\u0441\u0438\u0446\u0438\u0435\u0439
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C \u0432 \u044D\u043A\u0438\u043F\u0430\u0436\u0435
      \n\u043A \u043F\u043E\u043C\u0435\u0441\u0442\u044C\u044E \u0441\u044D\u0440\u0430
      \u041E\u0441\u0432\u0430\u043B\u044C\u0434\u0430 \u0411\u043B\u044D\u043A\u043C\u043E\u0440\u0430
      \u2014 \u0441\u0430\u043C\u043E\u0433\u043E \u0431\u043E\u0433\u0430\u0442\u043E\u0433\u043E
      \u0431\u0430\u0440\u0441\u0443\u043A\u0430 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430.
      \u041E\u043D \u0434\u0430\u0432\u0430\u043B \u0431\u043B\u0430\u0433\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0443\u0436\u0438\u043D, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u043B\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      \u041B\u0438\u0441\u0438\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 100000000025
    m_Localized: "\u041F\u0440\u0438\u0451\u043C \u0431\u044B\u043B \u0431\u043B\u0438\u0441\u0442\u0430\u0442\u0435\u043B\u0435\u043D,
      \u0433\u043E\u0441\u0442\u0435\u0439 \u2014 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E.
      \n\u041D\u043E \u043F\u0435\u0440\u0432\u0443\u044E \u0447\u0430\u0441\u0442\u044C
      \u0432\u0435\u0447\u0435\u0440\u0430 \u043C\u044B \u0441 \u041B\u0438\u0441\u0438\u0446\u0438\u0435\u0439
      \u043F\u0440\u043E\u0432\u0435\u043B\u0438 \u043F\u043E\u0440\u043E\u0437\u043D\u044C.
      \u041A \u043D\u0435\u0439, \u043A\u0430\u043A \u043A \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u043E\u0439
      \u043F\u0438\u0430\u043D\u0438\u0441\u0442\u043A\u0435, \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u043B\u0438
      \u043C\u043D\u043E\u0433\u0438\u0435. \n\u042F \u0436\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B
      \u043B\u0435\u0434\u0438\n\u0411\u044D\u043B\u043B\u0443 \u041D\u043E\u0442\u0442\u0438\u043D\u0433\u0435\u043C,\n\u0438
      \u043C\u044B \u0443\u0432\u043B\u0435\u043A\u043B\u0438\u0441\u044C \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 100000000026
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0433\u043E\u0441\u0442\u0438 \u043D\u0430\u0441\u044B\u0442\u0438\u043B\u0438\u0441\u044C
      \u0431\u0435\u0441\u0435\u0434\u0430\u043C\u0438, \u0441\u044D\u0440 \u0411\u043B\u044D\u043A\u043C\u043E\u0440
      \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441 \u043A\u0440\u0430\u0442\u043A\u0443\u044E,
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u0443\u0441\u0442\u0443\u044E
      \u0440\u0435\u0447\u044C \u043E \u0434\u043E\u0431\u0440\u043E\u0434\u0435\u0442\u0435\u043B\u0438
      \u043C\u0435\u0446\u0435\u043D\u0430\u0442\u043E\u0432. \u0417\u0430\u0442\u0435\u043C
      \u043D\u0430\u0441\u0442\u0430\u043B \u0447\u0435\u0440\u0451\u0434 \u041B\u0438\u0441\u0438\u0446\u0438\u0438:
      \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u043F\u043E\u043B\u043E\u043D\u0435\u0437, \u043F\u0430\u0440\u0430 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0445
      \u043D\u043E\u043A\u0442\u044E\u0440\u043D\u043E\u0432 \u2014 \u043F\u0443\u0431\u043B\u0438\u043A\u0430
      \u0440\u0443\u043A\u043E\u043F\u043B\u0435\u0441\u043A\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 100000000027
    m_Localized: "\u041B\u0438\u0441\u0438\u0446\u0438\u044F \u0431\u044B\u043B\u0430
      \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0430 \u0433\u043E\u0441\u0442\u044F\u043C\u0438,
      \u043F\u043E\u043A\u0430 \u043F\u0440\u0435\u0434\u0430\u0432\u0430\u043B\u0441\u044F
      \u0441\u043A\u0443\u043A\u0435. \n\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
      \u044F \u043F\u0435\u0440\u0435\u0443\u0441\u0435\u0440\u0434\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0441 \u0432\u044B\u043F\u0438\u0432\u043A\u043E\u0439 \u0438 \u043D\u0435
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u043A\u0430\u043A \u043E\u043D\u0430
      \u0438\u0441\u0447\u0435\u0437\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 100000000028
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043C\u0438\u043D\u0443\u043B\u043E,
      \u043D\u043E \u0432 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043C\u043E\u043C\u0435\u043D\u0442
      \u0441\u044D\u0440 \u0411\u043B\u044D\u043A\u043C\u043E\u0440 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
      \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u0442\u044C\u0441\u044F \u0432 \u0437\u0438\u043C\u043D\u0435\u043C
      \u0441\u0430\u0434\u0443 \u0438 \u0432\u044B\u043A\u0443\u0440\u0438\u0442\u044C
      \u043F\u043E \u0441\u0438\u0433\u0430\u0440\u0435. \u0413\u043E\u043B\u043E\u0432\u0430
      \u0433\u0443\u0434\u0435\u043B\u0430 \u043E\u0442 \u0432\u044B\u043F\u0438\u0442\u043E\u0433\u043E.
      \u041A \u0441\u0447\u0430\u0441\u0442\u044C\u044E, \u0411\u043B\u044D\u043A\u043C\u043E\u0440
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E\u0445\u043E\u0442\u043D\u043E
      \u0438 \u043D\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B \u043E\u0442\u0432\u0435\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 100000000029
    m_Localized: "\u042D\u0442\u043E\u0442 \u0443\u0436\u0430\u0441 \u043D\u0435
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0441\u043B\u043E\u0432\u0430\u043C\u0438!
      \u0410\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u044B\u0439 \u043C\u043E\u0440\u043E\u043A
      \u0440\u0430\u0441\u0441\u0435\u044F\u043B\u0441\u044F, \u043A\u043E\u0433\u0434\u0430\n\u044F
      \u0443\u0432\u0438\u0434\u0435\u043B \u0435\u0451, \u043B\u0435\u0436\u0430\u0449\u0443\u044E\n\u043D\u0430
      \u043C\u043E\u043A\u0440\u043E\u0439 \u0437\u0435\u043C\u043B\u0435.\n\u041F\u043B\u0430\u0442\u044C\u0435
      \u0437\u0430\u043F\u0430\u0447\u043A\u0430\u043B\u043E\u0441\u044C, \u0448\u0435\u0440\u0441\u0442\u044C
      \u0441\u043B\u0438\u043F\u043B\u0430\u0441\u044C, \u0430 \u0433\u043B\u0430\u0437\u0430
      \u0431\u044B\u043B\u0438 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B.\n\u041A\u0430\u043A
      \u0436\u0435, \u043A\u0430\u043A \u043C\u043D\u0435 \u0442\u0435\u043F\u0435\u0440\u044C\n\u0441
      \u044D\u0442\u0438\u043C \u0436\u0438\u0442\u044C!"
    m_Metadata:
