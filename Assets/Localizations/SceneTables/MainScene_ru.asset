  m_TableData:
  - m_Id: 100000000001
    m_Localized: "\u043F\u0443\u0441\u0442\u044C \u0442\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000002
    m_Localized: "\u043F\u0440\u0430\u0432\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000003
    m_Localized: "\u044F \u0433\u043E\u0442\u043E\u0432 \u0434\u0430\u0442\u044C
      \u043E\u0442\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000004
    m_Localized: "\u041C\u0430\u0441\u0442\u044C \u0420\u043E\u0437\u0430:\n\u043A\u0430\u0440\u0442\u044B
      \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u044E\u0442\u0441\u044F, \u0435\u0441\u043B\u0438
      \u043B\u0435\u0436\u0430\u0442 \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F
      \u043B\u044E\u0431\u044B\u043C\u0438 \u043A\u0430\u0440\u0442\u0430\u043C\u0438
      (\u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043A\u0430\u0440\u0442\u044B
      \u0441\u0432\u043E\u0435\u0439 \u043C\u0430\u0441\u0442\u0438)"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000005
    m_Localized: "\u041C\u0430\u0441\u0442\u044C \u0427\u0435\u0440\u0435\u043F:\n\u043A\u0430\u0440\u0442\u044B,
      \u043E\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u043F\u043E
      \u043A\u0440\u0430\u044F\u043C \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u0430,
      \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u044E\u0442 \u0441\u0432\u043E\u0439
      \u043D\u043E\u043C\u0438\u043D\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000006
    m_Localized: "\u041C\u0430\u0441\u0442\u044C \u041C\u043E\u043D\u0435\u0442\u0430:\n\u0435\u0441\u043B\u0438
      \u043A\u0430\u0440\u0442\u0430 \u043C\u043E\u043D\u0435\u0442 \u0441\u043E\u0441\u0435\u0434\u0441\u0442\u0432\u0443\u0435\u0442
      \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u043C\u043E\u043D\u0435\u0442\u043E\u0439,
      \u0435\u0451 \u043D\u043E\u043C\u0438\u043D\u0430\u043B \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u0434\u0432\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000007
    m_Localized: "\u041C\u0430\u0441\u0442\u044C \u041A\u043E\u0440\u043E\u043D\u0430:\n\u043A\u0430\u0440\u0442\u044B
      \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u044E\u0442\u0441\u044F, \u0435\u0441\u043B\u0438
      \u043D\u0435 \u0441\u043E\u0441\u0435\u0434\u0441\u0442\u0432\u0443\u044E\u0442
      \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u043A\u043E\u0440\u043E\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 100000000008
    m_Localized: "\u0446\u0432\u0435\u0442 \u0437\u0435\u0440\u043A\u0430\u043B\u0430
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0443
      \u0434\u043E\u043C\u0438\u043D\u0438\u0440\u0443\u044E\u0449\u0443\u044E \u043C\u0430\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000009
    m_Localized: "\u0446\u0432\u0435\u0442 \u0448\u0430\u0440\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043C\u0430\u0441\u0442\u044C, \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u0443\u044E
      \u0432 \u044D\u0442\u043E\u043C \u0440\u0430\u0443\u043D\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000010
    m_Localized: "\u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0439 \u0441\u0447\u0451\u0442 \u043C\u043E\u0436\u043D\u043E
      \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000011
    m_Localized: "\u0447\u0438\u0441\u043B\u043E, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0435
      \u0434\u043B\u044F \u043F\u043E\u0431\u0435\u0434\u044B \u0432 \u043A\u0430\u0436\u0434\u043E\u043C
      \u0440\u0430\u0443\u043D\u0434\u0435, \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000012
    m_Localized: 'MISS!


'
    m_Metadata:
      m_Items: []
  - m_Id: 100000000013
