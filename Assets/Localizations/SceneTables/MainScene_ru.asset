    m_Metadata:
      m_Items: []
  - m_Id: 100000000032
    m_Localized: "\u0422\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u0438\u0435\u043C \u0432 \u043F\u043E\u043C\u0435\u0441\u0442\u044C\u0435.
      \u0414\u043E\u043A\u0442\u043E\u0440 \u041C\u0443\u0440\u043B\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0441\u0432\u043E\u044E \u0441\u0442\u0430\u0440\u0443\u044E \u0437\u043D\u0430\u043A\u043E\u043C\u0443\u044E,
      \u043B\u0435\u0434\u0438 \u0411\u044D\u043B\u043B\u0443 \u041D\u043E\u0442\u0442\u0438\u043D\u0433\u0435\u043C.
      \u0413\u043E\u0441\u0442\u044F\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u043C\u043E\u043B\u043E\u0434\u043E\u0433\u043E \u043F\u043E\u044D\u0442\u0430-\u0440\u043E\u043C\u0430\u043D\u0442\u0438\u043A\u0430
      \u0422\u0435\u043E\u0434\u043E\u0440\u0430 \u041B\u0430\u043F\u0432\u0443\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 100000000033
